// Cloudflare Workers: el sitio es estático (dist/) y el Worker solo atiende
// /og/* (la API de imágenes) y /api/ubicacion/.
//
// La API /og/ necesita Workers Paid: dibujar una imagen usa más CPU que los
// 10 ms por petición del plan gratis. Por eso va apagada (API_OG=off): sitio,
// editor en el navegador y ubicación, gratis. Para prenderla, cambia aquí a
// "on": lo que diga este archivo gana sobre el dashboard en cada deploy.
{
  "name": "fabrica-ogimage",
  "compatibility_date": "2026-10-01",
  "main": "./worker/index.js",
  // wrangler deploy (y versions upload) construye antes de subir: así el deploy
  // no depende de que el dashboard tenga Build command. Tarda unos 6 minutos.
  "build": { "command": "npm run build", "watch_dir": [] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/og/*", "/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Las fuentes van dentro del Worker como bytes.
  "vars": { "API_OG": "off" },
  "keep_vars": true,
  "rules": [{ "type": "Data", "globs": ["**/*.woff"] }],
  "previews": {}
}
