---
import '@/styles/global.css'
import { NOMBRE, AUTOR, REPO, urlOg } from '@/lib/sitio'

interface Props {
  title: string
  description: string
  /** Ruta con diagonal final, p. ej. "/plantillas/". */
  path: string
  /** La imagen OG de esta página. Por defecto, la plantilla marca con el título. */
  og?: string
  noindex?: boolean
  schema?: Record<string, unknown>[]
}
const { title, description, path, og, noindex = false, schema = [] } = Astro.props
const canonical = new URL(path, Astro.site).href
// La fábrica hace sus propias imágenes OG: la plantilla marca con el título de cada página.
const ogImagen = new URL(og ?? urlOg('marca', { titulo: title.split(' | ')[0], sub: NOMBRE, autor: AUTOR.nombre, sitio: new URL(Astro.site!).hostname }), Astro.site).href
const NAV = [
  { href: '/plantillas/', label: 'Plantillas' },
  { href: '/galeria/', label: 'Galería' },
  { href: '/usar/', label: 'Úsala en tu sitio' },
]
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'max-image-preview:large'} />
    <meta name="author" content={AUTOR.nombre} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={NOMBRE} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:image:type" content={ogImagen.split('?')[0].endsWith('.jpg') ? 'image/jpeg' : 'image/png'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@gneuman" />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="border-b border-gray-200 bg-canvas">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 sm:px-6">
        <a href="/" class="font-semibold tracking-tight text-ink-900">Fábrica <span class="text-accent-600">OG</span></a>
        <nav class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-gray-700">
          {NAV.map((n) => <a href={n.href} class:list={['hover:text-ink-900', path.startsWith(n.href) && 'font-semibold text-ink-900']}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="contenido"><slot /></main>
    <footer class="mt-24 border-t border-gray-200">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-4 py-10 text-sm text-gray-600 sm:px-6">
        <p>Hecha por <a href={AUTOR.url} class="font-semibold text-ink-900 underline-offset-4 hover:underline">{AUTOR.nombre}</a>, director de IA fraccional. El código es abierto: <a href={REPO} class="underline underline-offset-4">github.com/gneuman/fabrica-ogimage</a>.</p>
        <p>Inspirada en <a href="https://ogimage.org" class="underline underline-offset-4">ogimage.org</a> de Ilias Ism (MIT), de donde viene buena parte de la galería. Cada imagen de la galería es de su empresa; si es tuya y quieres que la quitemos, <a href="mailto:soy@gabrielneuman.com?subject=Galer%C3%ADa%20de%20la%20f%C3%A1brica%20OG" class="underline underline-offset-4">escríbeme</a>.</p>
      </div>
    </footer>
  </body>
</html>
