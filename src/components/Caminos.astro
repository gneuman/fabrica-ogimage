---
// Las tres formas de usar la fábrica, de menos a más trabajo. Va en el inicio y en /usar/.
interface Props { enlaces?: boolean }
const { enlaces = true } = Astro.props
const CAMINOS = [
  { n: '1', titulo: 'En el editor', para: 'Para una imagen suelta', texto: 'Eliges una plantilla, escribes y descargas el PNG para subirlo a tu página o a tu CMS.', costo: 'Gratis, sin cuenta', href: '/plantillas/', cta: 'Abrir el editor' },
  { n: '2', titulo: 'En tu build', para: 'Para todas tus páginas', texto: 'Un comando lee el título de cada página al construir tu sitio y dibuja su imagen. Sin servidor.', costo: 'Gratis, en tu hosting de siempre', href: '/usar/#comando', cta: 'Ver el comando', recomendado: true },
  { n: '3', titulo: 'Por URL', para: 'Para sistemas que generan páginas solas', texto: 'Montas tu copia en un VPS, Docker o Cloudflare y la imagen sale de una dirección.', costo: 'Lo que cueste tu servidor', href: '/usar/#servidor', cta: 'Montar mi API' },
]
---
<div class="grid gap-5 md:grid-cols-3">
  {CAMINOS.map((c) => (
    <div class:list={['relative flex flex-col rounded-2xl border bg-white p-6', c.recomendado ? 'border-ink-900 shadow-lg' : 'border-gray-200']}>
      {c.recomendado && <span class="absolute -top-3 left-6 rounded-full bg-accent-600 px-3 py-1 text-xs font-semibold text-white">Recomendado</span>}
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink-900 text-sm font-semibold text-white">{c.n}</span>
      <p class="mt-4 text-lg font-semibold text-ink-900">{c.titulo}</p>
      <p class="text-sm text-gray-500">{c.para}</p>
      <p class="mt-3 flex-1 leading-relaxed text-gray-700">{c.texto}</p>
      <p class="mt-4 text-xs font-semibold tracking-wide text-accent-600 uppercase">{c.costo}</p>
      {enlaces && <a href={c.href} class="mt-4 inline-flex items-center gap-1 font-semibold text-ink-900 underline-offset-4 hover:underline">{c.cta} <span aria-hidden="true">→</span></a>}
    </div>
  ))}
</div>
