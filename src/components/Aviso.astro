---
import Base from '@/layouts/Base.astro'
interface Props { titulo: string; texto: string; path: string }
const { titulo, texto, path } = Astro.props
---
<Base title={`${titulo} | Fábrica OG`} description={texto} path={path} noindex>
  <section class="mx-auto max-w-2xl px-4 py-24 text-center sm:px-6">
    <h1 class="font-serif text-4xl text-ink-900">{titulo}</h1>
    <p class="mt-4 text-lg text-gray-700">{texto}</p>
    <a href="/plantillas/" class="mt-8 inline-block rounded-full bg-accent-600 px-6 py-3 text-sm font-semibold text-white hover:bg-accent-700">Ir a las plantillas</a>
  </section>
</Base>
